{
  "name": "stockyllix-server",
  "version": "1.5.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=2",
    "lint": "eslint .",
    "seed:local": "tsx src/scripts/seed-local.ts",
    "smoke:local": "tsx src/scripts/smoke-local.ts",
    "test:load": "tsx src/scripts/load-test.ts",
    "import:boi": "tsx src/scripts/import-boi.ts",
    "import:yahoo": "tsx src/scripts/import-yahoo.ts",
    "test:emulator": "vitest run tests/firestore.integration.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "firebase-admin": "14.5.0",
    "helmet": "^8.1.0",
    "luxon": "^3.7.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.0",
    "firebase-tools": "^15.34.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  }
}
