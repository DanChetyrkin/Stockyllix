NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# use demo-stockyllix with emulators; stockyllix for the real project
FIREBASE_PROJECT_ID=demo-stockyllix
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
ADMIN_UIDS=replace-with-your-auth-uid
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# local only: the seed for the simulated world used when HISTORICAL_DATASET_PATH is not set
DATASET_SEED=replace-with-a-private-random-value
# run import:boi to stage the official bank of israel rates
# BOI_FX_DATA_PATH=./data/boi-fx.json
# for cloud use, remove emulator variables and provide one credential option
# GOOGLE_APPLICATION_CREDENTIALS=C:/private/stockyllix-service-account.json
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# the private historical snapshot; production requires it
# HISTORICAL_DATASET_PATH=./data/yahoo-world.json
# private input files for npm run import:yahoo
# YAHOO_REPORT_PATH=../artifacts/yfinance-probe/extended-result.json
# YAHOO_CALENDAR_PATH=./data/yahoo-calendar.json
# YAHOO_OUTPUT_PATH=./data/yahoo-world.json
