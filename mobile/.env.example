# public settings are included in the web build; never put private keys here.
EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=stockyllix.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=stockyllix
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_USE_EMULATORS=false
# for emulator work, use the same demo project id as the api server.
EXPO_PUBLIC_AUTH_EMULATOR_URL=http://127.0.0.1:9099
