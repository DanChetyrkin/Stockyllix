{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": [
    {
      "site": "stockyllix",
      "public": "mobile/dist",
      "ignore": ["firebase.json", "**/.*", "node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [
        { "source": "**", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
        { "source": "**/*.@(js|css|png|svg|woff2)", "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }] },
        { "source": "/demo/**", "headers": [{ "key": "Cache-Control", "value": "public,max-age=86400" }] }
      ]
    },
    {
      "site": "stockyllix-panels",
      "public": "widgets",
      "ignore": ["**/.*"],
      "headers": [{ "source": "**", "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors https://stockyllix.web.app https://stockyllix.firebaseapp.com http://localhost:8081 http://127.0.0.1:8081" }
      ] }]
    }
  ],
  "emulators": {
    "auth": { "host": "127.0.0.1", "port": 9099 },
    "firestore": { "host": "127.0.0.1", "port": 8080 },
    "ui": { "enabled": true, "host": "127.0.0.1", "port": 4000 },
    "singleProjectMode": true
  }
}
